+            case *amd64*     : architecture ?= x86 ;
+            case *86*        : architecture ?= x86 ;
+            case *powerpc*   : architecture ?= power ;
+            case *ppc*       : architecture ?= power ;
+            case *sparc*     : architecture ?= sparc ;
+            case *s390*      : architecture ?= s390x ;
+            case *riscv*     : architecture ?= riscv ;
+            case *loongarch* : architecture ?= loongarch ;
+            case *mips64*    : architecture ?= mips64 ;
+            case *mips*      : architecture ?= mips ;
+            case *hppa*      : architecture ?= parisc ;
+            case *parisc*    : architecture ?= parisc ;
+            case *ia64*      : architecture ?= ia64 ;
+        }
+
+        local conditionx ;
+        if $(target-os) || $(architecture)
+        {
+            conditionx = [ regex.replace $(condition) "/" "," ] ;
+        }
+        if $(target-os) && ! [ feature.get-values <target-os> : $(options) ]
         {
-            local conditionx = [ regex.replace $(condition) "/" "," ] ;
             toolset.add-defaults $(conditionx)\:<target-os>$(target-os) ;
         }
+        if $(architecture) && ! [ feature.get-values <architecture> : $(options) ]
+        {
+            toolset.add-defaults $(conditionx)\:<architecture>$(architecture) ;
+        }
     }
 }

